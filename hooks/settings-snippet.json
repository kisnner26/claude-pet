{
  "hooks": {
    "SessionStart":       [{ "hooks": [{ "type": "command", "command": "$HOME/.claude-pet/pet-hook.sh SessionStart",       "timeout": 5 }] }],
    "UserPromptSubmit":   [{ "hooks": [{ "type": "command", "command": "$HOME/.claude-pet/pet-hook.sh UserPromptSubmit",   "timeout": 5 }] }],
    "PreToolUse":         [{ "hooks": [{ "type": "command", "command": "$HOME/.claude-pet/pet-hook.sh PreToolUse",         "timeout": 5 }] }],
    "PostToolUse":        [{ "hooks": [{ "type": "command", "command": "$HOME/.claude-pet/pet-hook.sh PostToolUse",        "timeout": 5 }] }],
    "PostToolUseFailure": [{ "hooks": [{ "type": "command", "command": "$HOME/.claude-pet/pet-hook.sh PostToolUseFailure", "timeout": 5 }] }],
    "PermissionRequest":  [{ "hooks": [{ "type": "command", "command": "$HOME/.claude-pet/pet-hook.sh PermissionRequest",  "timeout": 5 }] }],
    "PermissionDenied":   [{ "hooks": [{ "type": "command", "command": "$HOME/.claude-pet/pet-hook.sh PermissionDenied",   "timeout": 5 }] }],
    "Stop":               [{ "hooks": [{ "type": "command", "command": "$HOME/.claude-pet/pet-hook.sh Stop",               "timeout": 5 }] }],
    "StopFailure":        [{ "hooks": [{ "type": "command", "command": "$HOME/.claude-pet/pet-hook.sh StopFailure",        "timeout": 5 }] }],
    "SessionEnd":         [{ "hooks": [{ "type": "command", "command": "$HOME/.claude-pet/pet-hook.sh SessionEnd",         "timeout": 5 }] }]
  }
}
